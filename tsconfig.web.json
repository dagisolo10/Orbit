{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": ["./src/renderer/src/**/*", "./src/preload/*.d.ts", "./src/shared/**/*"],
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "paths": {
            "@shared/*": ["./src/shared/*"],
            "@/*": ["./src/renderer/src/*"]
        }
    }
}
